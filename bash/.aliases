#!/bin/bash
#   ____  ____  ____  ____
#  ||i  |||o  |||d  |||s  |
#  ||___|||___|||___|||___|
#  |/___\|/___\|/_ _\|/___\
#
# Executed for login shells. This file is not read by bash when ~/.bash_profile
# or ~/.bash_login exist.
