# cron
  sudo crontab -l -u <user>                                     # view cron jobs for a specific user
  sudo crontab -e -u <user>                                     # edit cron jobs for a specific user
  sudo sh -c 'tail -n +1 /var/spool/cron/*'                     # list crontab for all users